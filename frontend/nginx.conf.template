limit_req_zone $binary_remote_addr zone=ktpm_bids:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=ktpm_auth:10m rate=3r/s;
limit_conn_zone $binary_remote_addr zone=ktpm_streams:10m;
upstream ktpm_api {
  least_conn;
  server ${BACKEND_UPSTREAM} max_fails=2 fail_timeout=5s;
  server ${BACKEND_SECONDARY_UPSTREAM} max_fails=2 fail_timeout=5s;
  keepalive 32;
}
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  location = /index.html { add_header Cache-Control "no-cache"; }
  limit_req_status 429;
  location = /api/events {
    limit_conn ktpm_streams 5;
    proxy_pass http://ktpm_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 75s;
    add_header X-Accel-Buffering no;
  }
  location ~ ^/api/auctions/[0-9]+/bids$ {
    limit_req zone=ktpm_bids burst=20 nodelay;
    proxy_pass http://ktpm_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;
    proxy_next_upstream off;
  }
  location ~ ^/api/auth/(login|register)$ {
    limit_req zone=ktpm_auth burst=10 nodelay;
    proxy_pass http://ktpm_api;
    proxy_set_header Host $http_host;
    proxy_next_upstream off;
  }
  location /api/ {
    proxy_pass http://ktpm_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 2s;
    proxy_read_timeout 10s;
    proxy_next_upstream error timeout http_502 http_503;
  }
  location /assets/ { try_files $uri =404; expires 7d; }
  location / { try_files $uri $uri/ /index.html; }
}
